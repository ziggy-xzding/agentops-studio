# Optional local overrides. Copy this file to .env; never commit .env.
# The backend works without this file and defaults to local SQLite.
DATABASE_URL=sqlite:///./agentops.db
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Docker Compose development values. These are local-only placeholders.
POSTGRES_DB=agentops
POSTGRES_USER=agentops
POSTGRES_PASSWORD=agentops-local-only
FRONTEND_PORT=3000
